<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for WHIP, sampled from images/whip_avatar.jpg.
  Avatar palette: red and blue spider on night black.
  Used by the GitHub Pages site (index.html) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#080A12"/>  <!-- window / page background -->
  <colour name="panel"            value="#0E1120"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#1D223F"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#15192E"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#F2E9EA"/>  <!-- primary text -->
  <colour name="text_sec"         value="#A89497"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#6B575A"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#D34859"/>  <!-- logo, links, selected / hover -->
  <colour name="accent_hover"     value="#DA6473"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#1A7BD9"/>  <!-- second avatar colour: highlights, tags -->
  <colour name="accent3"          value="#CC4A82"/>  <!-- third avatar colour -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#250E11"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
